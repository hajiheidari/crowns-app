{
  "expo": {
    "name": "Crowns",
    "slug": "crowns",
    "version": "0.8.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crowns",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.amixstudio.crowns"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F1B16",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amixstudio.crowns",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#1C1A17",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ],
          "userTrackingUsageDescription": "Your data is used only to show ads that fit you better. Crowns works the same either way."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Your data is used only to show ads that fit you better. Crowns works the same either way."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
