{
  "expo": {
    "name": "Tiaro",
    "slug": "crowns",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tiaro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.espadna.tiaro",
      "associatedDomains": [
        "applinks:tiaro.espadna.com"
      ],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Tiaro only uses your photos if you choose to share your result picture to an app like Instagram.",
        "NSPhotoLibraryAddUsageDescription": "Tiaro saves your result picture only when you choose to share or save it."
      },
      "supportsTablet": true,
      "requireFullScreen": true,
      "entitlements": {
        "com.apple.developer.game-center": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F1B16",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.espadna.tiaro",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tiaro.espadna.com",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "tiaro.espadna.com",
              "path": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#1C1A17",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "./plugins/with-no-push-entitlement",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.espadna.tiaro",
          "widgets": [
            {
              "name": "BrainWidget",
              "displayName": "Tiaro",
              "description": "Your weekly brain score, streak and today's puzzle.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5cf65480-2b08-4d41-884a-8dd2b94deb52"
      }
    },
    "owner": "hajiheidaris-team",
    "locales": {
      "ar": "./locales/ar.json",
      "fa": "./locales/fa.json",
      "ru": "./locales/ru.json"
    }
  }
}
